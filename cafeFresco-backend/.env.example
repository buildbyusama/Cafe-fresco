# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DB_URI=mongodb://127.0.0.1:27017/cafefresco
# 64 random bytes: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=
STRIPE_SECRET_KEY=sk_test_
CURRENCY=usd
# Gmail address + Gmail *app password* (Google account → Security → App passwords)
EMAIL=
EMAIL_PASSWORD=
CONTACT_TO=
CLIENT_URL=http://localhost:3001
EMAIL_RESET_URL=http://localhost:5173
EMAIL_USER_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
APP_TZ=Asia/Karachi
UPLOAD_MAX_MB=2
STALE_CARD_ORDER_MIN=30
# First root admin for: npm run seed:admin
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Requests per 15 min per IP (default 600)
API_RATE_LIMIT=600
# VPN check on customer signup/login (vpnapi.io)
VPN_CHECK=false
VPNAPI_KEY=
# Optional Stripe webhook (POST /stripe/webhook)
STRIPE_WEBHOOK_SECRET=
