# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DB_URI=mongodb://127.0.0.1:27017/cafefresco
# 64 random bytes: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=
STRIPE_SECRET_KEY=sk_test_
CURRENCY=usd
# Gmail address + Gmail *app password* (Google account → Security → App passwords)
EMAIL=
EMAIL_PASSWORD=
CONTACT_TO=
CLIENT_URL=http://localhost:3001
EMAIL_RESET_URL=http://localhost:5173
EMAIL_USER_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
APP_TZ=Asia/Karachi
UPLOAD_MAX_MB=2
STALE_CARD_ORDER_MIN=30
# First root admin for: npm run seed:admin
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Requests per 15 min per IP (default 600)
API_RATE_LIMIT=600
# VPN check on customer signup/login (vpnapi.io)
VPN_CHECK=false
VPNAPI_KEY=
# Optional Stripe webhook (POST /stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# ---- AI assistant (OpenAI). Without OPENAI_API_KEY the shop falls back to rule-based answers.
OPENAI_API_KEY=
# Small, low-cost chat model and embedding model
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# USD per 1M tokens, used for the dashboard cost estimate
OPENAI_PRICE_IN=0.15
OPENAI_PRICE_OUT=0.60
# true = scripted offline answers (tests, no cost)
AI_MOCK=false
AI_TIMEOUT_MS=20000
# Hard stop per day (input + output tokens); above it chat uses the rule-based fallback
AI_DAILY_TOKEN_BUDGET=2000000
CHAT_ENABLED=true
CHAT_RETENTION_DAYS=30
# Signs the guest cookie (cf_anon). 32+ random chars.
COOKIE_SECRET=
